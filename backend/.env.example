# Port for Express server (Cloud Run defaults to 8080)
PORT=8080

# Google Cloud / Firebase Project ID
GCP_PROJECT=your-gcp-project-id
FIREBASE_PROJECT_ID=your-gcp-project-id

# Gemini API Configuration
# In Cloud Run: Provided via Secret Manager (--set-secrets=GEMINI_API_KEY=gemini-api-key:latest)
# In Local Dev: Either provide directly below OR let the backend fetch it from Secret Manager via ADC
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SECRET_NAME=gemini-api-key

# Optional: Path to Firebase Service Account JSON (for local backend testing without gcloud ADC)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
